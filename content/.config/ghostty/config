# Ghostty Configuration
# Migrated from Kitty configuration

background = #000000
font-family = "Hasklig"

# Enable ligatures
font-feature = calt
font-feature = liga

cursor-style = underline
mouse-hide-while-typing = true

# macOS Settings
quit-after-last-window-closed = true

# Enable Option as Alt (use 'both' for both keys, 'left' for left only)
macos-option-as-alt = left
macos-titlebar-style = hidden 

# Unbind default Ghostty keybindings that conflict with Zellij
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+up=unbind
keybind = alt+down=unbind
