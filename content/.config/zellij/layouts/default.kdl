layout {
    pane split_direction="vertical" {
        pane size=41 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-vertical-tabs.wasm" {
                format "#[fg=muted] {=39:name}"
                format_active "#[fg=#aaaaaa,bg=#2e2e2e,fill] {=39:name}"
                max_name_length 39
            }
        }
        pane
    }
}
